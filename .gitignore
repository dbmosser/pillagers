# A/B scratch: fixture built from an older revision, and the extracted source it
# came from. Both are regenerated by tools/mkfixture.ps1 -Src -Dst on demand.
# generated by tools/mkfixture.ps1 from dark_raiders.html, rebuilt every edit
*.log
builds/
dark_raiders_run*.txt
node_modules/
tools/fixture.html
tools/fixture_prev.html
tools/prev_src.html
tools/shots/
tools/publish/
backups/
exports/run-*.txt
tools/fx[0-9]*.html
tools/prev[0-9]*.html
tools/cloud/__pycache__/
tools/fixture-soak-*.html
tools/handoff/fuzz/*.jsonl
tools/handoff/fuzz/fuzz-trace.txt
tools/gd-*.html

# 2026-10-18: the stable play copy (tools/stable.sh): an exact copy of one old version, served by :8802 as /stable.html. The git tag stable-vNN.NN keeps it.
/stable.html
/stable.html.tmp
tools/handoff/reports/cache/

# 2026-10-18: a ship commits with git add -A, so scratch files from preflights and probes that happened to exist were swept in
# (a 12 MB fxprobe68.html in v30.69, and the preflight patch files ppfX/fpfX that each preflight then deletes again).
tools/fxdry*.html
tools/fxctl*.html
tools/fxprobe*.html
tools/fxcorpus*.html
tools/handoff/ppf[a-z].ps1
tools/handoff/fpf[a-z].ps1

# 2026-10-18: the art survey builds patched copies of the game (12 MB each) to photograph options; never commit them
tools/handoff/art-survey/game/
tools/handoff/art-survey/mock/*.png
tools/handoff/art-survey/mock/_lc_*.html
.claude/settings.local.json
tools/fxslice*.html
tools/fxpin*.html
exports/*NOT-REAL-bridge-test*
tools/handoff/notes-fetch.txt
# 10-20 the spare PC (tools/spare/): its marker file, and the VM's mirror of its results
/.spare-pc
/tools/handoff/spare/
/tools/handoff/spare-status.txt
