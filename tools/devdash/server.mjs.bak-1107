      tot.set(name, (tot.get(name) || 0) + s); all += s;
    }
    const top = [...tot].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([name, v]) => ({ name, pct: all ? Math.round(1000 * v / all) / 10 : 0 }));
    whoOut = { hours: WHO_H, top, total: Math.round(all / 1000), at: now, partial };
