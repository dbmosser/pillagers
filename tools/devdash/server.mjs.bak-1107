  const runs = []; for (const l of tail(CX + '/runs.txt', 600)) { const x = /^(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d) (\S+) (\d+)s (\S+) (\w+)/.exec(l); if (x) runs.push({ atMs: new Date(+x[1], +x[2] - 1, +x[3], +x[4], +x[5]).getTime(), name: x[6], result: x[9].toUpperCase() }); }
