    if (e) return;
    try { const a = JSON.parse(b); if (Array.isArray(a)) jt.transfers = a.filter(x => x && typeof x.path === 'string' && /\.part$/i.test(x.path)).slice(0, 5).map(x => ({ name: cutS(x.path.split(/[\\/]/).pop().replace(/\.part$/i, ''), 60), bytes: numOr(x.bytes) })); } catch {}
  });
}
